  },
  "item": [
    {
      "name": "Login API - Valid Credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login API returns status 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Login response indicates success\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.success).to.eql(true);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"YOUR EMAIL\",\r\n  \"password\": \"YOUR PASSWORD\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/account/authenticate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "account",
            "authenticate"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login API - Invalid Credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"API returns HTTP 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Invalid login is rejected\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.success).to.eql(false);\r",
              "});\r",
              "\r",
              "pm.test(\"Invalid login error message is displayed\", function () {\r",
              "    pm.expect(pm.response.text().toLowerCase())\r",
              "        .to.include(\"invalid email\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"YOUR EMAIL\",\r\n  \"password\": \"YOUR PASSWORD\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/account/authenticate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "account",
            "authenticate"
          ]
        }
      },
      "response": []
    }
  ]
}
